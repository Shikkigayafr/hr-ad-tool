# ==========================================
# FLASK (ВЕБ-ПАНЕЛЬ)
# ==========================================
# ПАРОЛИ И КЛЮЧИ в Docker лежат в secrets/ (python scripts/init_secrets.py), а не здесь.
# Значения ниже нужны только для запуска без Docker (python app.py); файл secrets/ имеет приоритет.
# Любой секрет можно также передать файлом: SECRET_KEY_FILE=/путь/к/файлу
#
# Сгенерировать ключ: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_random_64_hex_chars
# Пароль первого админа для `flask init-db` (если не задан — сгенерируется и покажется в консоли)
INITIAL_ADMIN_PASSWORD=

# true — если панель открывается по HTTPS (cookie только по защищённому соединению)
SESSION_COOKIE_SECURE=false
# true — если панель стоит за reverse-proxy (nginx и т.п.): IP клиента берётся из X-Forwarded-For
TRUST_PROXY=false
# Другие origin для Socket.IO через запятую (по умолчанию — только свой)
CORS_ORIGINS=

# ==========================================
# БАЗА ДАННЫХ
# ==========================================
# По умолчанию SQLite (instance/hr.db) — удобно для разработки.
# В Docker compose используется PostgreSQL (POSTGRES_* задаются в docker-compose.yml, пароль — secret).
# Своя БД: DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# ==========================================
# ЛОГИ (JSON, stdout + файл с ротацией)
# ==========================================
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ==========================================
# ACTIVE DIRECTORY (AD)
# ==========================================
# true — только имитировать создание (без подключения к AD)
DRY_RUN=true
AD_SERVER=ldaps://your_ad_ip_or_hostname
AD_USER=CORP\svc_hr
# Пароль сервисной учётки в Docker — в secrets/ad_password.txt; здесь — для запуска без Docker
AD_PASSWORD=your_ad_service_password
# Путь к PEM с сертификатом DC (или корневым CA). Если задан — LDAPS проверяет сертификат и имя хоста.
# Экспорт: certlm.msc -> сертификат DC -> Все задачи -> Экспорт -> Base-64 (.cer). Положите файл рядом и смонтируйте в Docker.
AD_CA_CERTS_FILE=
AD_DOMAIN=corp.local
BASE_DN=DC=corp,DC=local
USERS_OU=OU=NewUsers,DC=corp,DC=local
# OU с группами Sbis_Stager / Sbis_Main / Sbis_Senior (по умолчанию OU=Groups,<BASE_DN>)
GROUPS_OU=OU=Groups,DC=corp,DC=local
# Сюда переезжают отключённые (уволенные) сотрудники; OU создаёт infra/ad/02-Configure-AD.ps1
DISABLED_OU=OU=Disabled,DC=corp,DC=local

# true — «Повысить» и «Удалить» в панели меняют ещё и AD (группы, удаление учётки).
# false — меняется только база панели. Включайте после проверки на тестовом AD.
AD_SYNC_CHANGES=false

# ==========================================
# SABY (СБИС)
# ==========================================
# true — после создания в AD создавать сотрудника и в Saby
SABY_ENABLED=false
SABY_LOGIN=your_saby_login
# В Docker — secrets/saby_password.txt
SABY_PASSWORD=your_saby_password

# ИНН организации (для запросов API)
SABY_ORG_INN=your_org_inn_here

# ID подразделений в Saby (числовые; значения по умолчанию зашиты в saby_config.py)
SABY_DEPT_HOT_SALES=
SABY_DEPT_STAGERS_TP=
SABY_DEPT_CALL_CENTER=
SABY_DEPT_COORDINATOR=
SABY_DEPT_SMM=
SABY_DEPT_QUALITY=
SABY_DEPT_PROLONG=
SABY_DEPT_OFFICE=
SABY_DEPT_OUTGOING=
SABY_DEPT_INCOMING=
SABY_DEPT_DEVELOPMENT=
SABY_DEPT_TECH_SUPPORT=
SABY_DEPT_CLOUD=
SABY_DEPT_REMOTE=
